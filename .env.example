
# --- Pinecone (obligatorio) 
PINECONE_API_KEY=
INDEX_NAME=volkswagen-rag-hibrido
NAMESPACE=vw-modelos-dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM (opcional: solo para python main.py --responder) ---
# La ingesta, el recuperador y evaluate.py NO usan LLM (los embeddings son
# locales y gratuitos). Completá al menos una key si querés respuestas
# redactadas. Si LLM_PROVIDER está vacío, se usa la primera key que
# encuentre en este orden: OpenAI, Anthropic, Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

DEBUG_RETRIEVAL=true
PROVIDER_CHAIN=openai,anthropic

TEMPERATURE=0.2

# --- Ingesta ---
DATA_DIR=data
CHUNK_SIZE=600
CHUNK_OVERLAP=100
BATCH_SIZE=100

# --- Recuperación ---
TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
